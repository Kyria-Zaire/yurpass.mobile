# App
NODE_ENV=development
PORT=3000

# MongoDB (local Docker)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGODB_URI=mongodb://yurpass-app:${MONGO_APP_PASSWORD}@mongodb:27017/yurpass

# MongoDB (Atlas — production only)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yurpass

# Redis
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=yurpass_dev_redis
REDIS_PORT=6380

# Auth
BETTER_AUTH_SECRET=<min-32-chars-random-string>
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (emails)
RESEND_API_KEY=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000
